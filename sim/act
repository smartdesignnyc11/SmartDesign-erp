#!/usr/bin/env python3
"""sim/act: a person's toolkit in the agent month. You act only as yourself, only through your own screens.

    sim/act <uid> help                     every verb
    sim/act <uid> screen [--full] [--shot] [--marks] | find "text"
    sim/act <uid> tap <n>|"Label" | type <n>|"Label" "text" [--enter] | pick <n>|"Label" "option" | upload <n> <file> | photo <n>
    sim/act <uid> do 'type 3 "8"; pick "Unit" "sheet"; tap "Save"' [--find "text"]   up to 8 steps in one call
    sim/act <uid> back | scroll | key Enter | go "<menu label>" | ask "question" | news
    sim/act <uid> device | device phone | device desktop     which device you are on; switch when your turn allows it
    sim/act <uid> mail [sent] | mail read <n> | mail reply <n> "text" [--all] | mail send "to, to" "subject" "body" [--cc "a, b"]
    sim/act <uid> call "<person>" "what was said"
    any action may carry --why "the one-line reason" (the measure or the Standard behind it); it goes in the record

It talks to the running world (sim/server.py) of the current run (sim/runs/.current, or SIM_RUN). It refuses
anything that is not a person's action: there is no way to run JavaScript or to read or write the database.
"""
import json, os, sys, urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
VERBS = {'do', 'screen', 'find', 'tap', 'type', 'pick', 'upload', 'photo', 'back', 'scroll', 'go', 'ask', 'mail', 'call', 'news', 'help', 'key', 'device'}
FORBIDDEN = {'eval', 'evaluate', 'js', 'javascript', 'db', 'sql', 'query', 'exec', 'run', 'script', 'console', 'devtools', 'storage', 'indexeddb',
             'localstorage', 'dump', 'export', 'state', 'set', 'get', 'admin', 'debug'}


def main(argv):
    if len(argv) < 2 or argv[1] in ('-h', '--help'):
        print(__doc__.strip()); return 2
    uid, verb, rest = argv[0], argv[1].lower(), argv[2:]
    if verb not in VERBS:
        why = 'reading or writing the database or running code is not something a person can do' if verb in FORBIDDEN else f'"{verb}" is not a verb'
        print(f'refused: {why}. You work only through your screens: {", ".join(sorted(VERBS))}.')
        post({'uid': uid, 'cmd': verb, 'args': [], 'opts': {}}, quiet=True)   # the world logs the attempt
        return 3
    opts, args, i = {}, [], 0
    while i < len(rest):
        a = rest[i]
        if a in ('--full', '--shot', '--enter', '--all', '--marks'): opts[a[2:]] = True
        elif a in ('--page', '--find', '--cc', '--why') and i + 1 < len(rest): opts[a[2:]] = rest[i + 1]; i += 1
        else: args.append(a)
        i += 1
    r = post({'uid': uid, 'cmd': verb, 'args': args, 'opts': opts})
    if r is None: return 4
    print(r.get('text', ''))
    return 0 if r.get('ok') else 1


def post(body, quiet=False):
    run = os.environ.get('SIM_RUN') or (open(os.path.join(HERE, 'runs', '.current')).read().strip() if os.path.exists(os.path.join(HERE, 'runs', '.current')) else '')
    sj = os.path.join(HERE, 'runs', run, 'server.json')
    if not run or not os.path.exists(sj):
        if not quiet: print('the world is not running (start it with: python3 sim/server.py --run <name>)')
        return None
    port = json.load(open(sj))['port']
    req = urllib.request.Request(f'http://127.0.0.1:{port}/act', data=json.dumps(body).encode(), headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=300) as f: return json.loads(f.read())
    except Exception as e:
        if not quiet: print(f'the world did not answer: {e}')
        return None


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
