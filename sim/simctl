#!/usr/bin/env python3
"""sim/simctl: the main session's controls for the agent month (never given to the role agents).

    sim/simctl status
    sim/simctl world <morning|work1|work2|eod> [--no-watchers|--watchers]   the outside world's events for the slot
    sim/simctl plan sim/day_plan_lean.json       which day plan this run follows (default sim/day_plan.json)
    sim/simctl begin <uid> live [--cap N] [--device phone|desktop]   a turn on the LIVE site (a run started with server.py --live <role>,
                                                sim/live.py): both devices in hand, no world, no clock pin; `prompt` gives sim/turn_prompt_live.md
    sim/simctl begin <uid> <slot> [--cap N] [--device phone|desktop] [--switch]   open a person's turn (only they may
                                                act until `end`); the plan's cap for the slot, raised by a doc task; the device
                                                from the doc task, else the plan's `devices` (day, slot, person), else the role's;
                                                --switch (or "phone+desktop" in the plan) lets them pick up the other device
    sim/simctl cost <uid|label> --tokens N [--tool-uses N] [--ms N]   the subagent's measured usage for the turn just
                                                ended (copy it from the Agent tool's result); written to cost.jsonl and cost.md
    sim/simctl end                              close the turn: save, deliver the mail they sent
    sim/simctl prompt <uid>                     print the filled per-turn prompt (sim/turn_prompt.md) for that person
    sim/simctl brief <uid>                      their news and unread mail counts (to decide optional turns)
    sim/simctl referee [--final]                score the world now (writes ledger.json and ledger.md)
    sim/simctl advance                          score the day, keep a copy of the snapshot, move to the next working day
    sim/simctl persist                          the PERSIST reload check (end of the run)
    sim/simctl check '<json list of month_runtime checks>'
    sim/simctl party "<name>" '<json patch>'      change an outside party's rules, e.g. '{"reply_p": 1, "delay": [0, 0]}'
    sim/simctl world-client on|off              the client's portal side (approve, ask, pay) played by world rules (lean plan)
    sim/simctl world-agent on|off               write each scheduled outside reply to world/pending/ for an LLM to voice
    sim/simctl world-voice on|off               the voicer: each outside reply written in the party's own words by the live model when it
                                                falls due (sim/voicer.py; needs SIM_AI_TOKEN_FILE on the server), facts kept, template on failure
    sim/simctl menus                            capture each person's menu and tabs to runs/<run>/menus.json (menu workshop)
    sim/simctl client-docs                      render every client-facing document created (print, PDF, portal) to runs/<run>/client_docs/
    sim/simctl cycle on|off [--play u_controller]   Pilot 3: the business-cycle book (sim/cycle_book.json) and its scripted roles (--play: those that play after all)
    sim/simctl script '<json>'                 Pilot 3: run one scripted world action again (sim/script_p3.js), e.g. '{"do": "payroll", "as": "u_controller"}'
    sim/simctl judge <uid> [--day D]            Pilot 3: the realism judge's prompt for that person's day (sim/realism_judge.md); the trail is written beside it
    sim/simctl begin ... --minutes N            a budget of working minutes for the turn (the plan's `minutes` per slot otherwise)
    sim/simctl stop                             save everything and stop the server
"""
import json, os, sys, urllib.request
from datetime import date

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
def plan():
    run, d = run_dir()
    f = os.environ.get('SIM_PLAN') or (open(os.path.join(d, 'plan.txt')).read().strip() if os.path.exists(os.path.join(d, 'plan.txt')) else os.path.join(HERE, 'day_plan.json'))
    return json.load(open(f if os.path.isabs(f) else os.path.join(os.path.dirname(HERE), f)))


def day_no():
    return len(admin('status').get('days_done') or []) + 1


def my_tasks(uid, slot):
    """the Documents Workshop's work that came in for this person, this day and slot (day_plan doc_tasks)"""
    day = day_no()
    return [t for t in plan().get('doc_tasks', []) if t['uid'] == uid and t['day'] == day and t['slot'] == slot]


def task_device(t):
    return (t.get('device') or ('phone' if t.get('phone') else '')).lower()


def plan_device(uid, slot, tasks):
    """The device for this turn: a task's device first, then the plan's `devices` for the day and slot, then the plan's
    default for the person; "phone+desktop" starts on the phone and lets the person switch (`act <uid> device desktop`)."""
    P = plan().get('devices') or {}
    for t in tasks:
        if task_device(t): return task_device(t)
    d = ((P.get(str(day_no())) or {}).get(slot) or {}).get(uid) or (P.get('default') or {}).get(uid) or ''
    return d.lower()


SLOT_LABEL = {'work': 'the work day', 'morning': 'morning (brief, huddle, plan)', 'work1': 'the work day, first turn', 'work2': 'the work day, second turn',
              'eod': 'end of day (log, confirm tomorrow, diary, judgement)'}


def run_dir():
    run = os.environ.get('SIM_RUN') or open(os.path.join(HERE, 'runs', '.current')).read().strip()
    return run, os.path.join(HERE, 'runs', run)


def admin(cmd, **kw):
    run, d = run_dir()
    port = json.load(open(os.path.join(d, 'server.json')))['port']
    tok = open(os.path.join(d, '.admin_token')).read().strip()
    req = urllib.request.Request(f'http://127.0.0.1:{port}/admin', data=json.dumps({'cmd': cmd, **kw}).encode(),
                                 headers={'Content-Type': 'application/json', 'X-Sim-Token': tok})
    with urllib.request.urlopen(req, timeout=1800) as f: return json.loads(f.read())


def plan_cap(uid, slot):
    """the turn's action cap: Pilot 3's per role, per slot and per day (caps[uid][slot], cap_days[day][uid][slot]),
    else the plan's per slot (the work slots share 'work'), else SIM_CAP"""
    P = plan(); C = P.get('caps', {})
    day = (P.get('cap_days') or {}).get(str(day_no()), {}).get(uid, {})
    if slot in day: return int(day[slot])
    if isinstance(C.get(uid), dict): return int(C[uid].get(slot) or C[uid].get('work' if slot.startswith('work') else slot) or 25)
    return int(C.get(slot) or C.get('work' if slot.startswith('work') else slot) or os.environ.get('SIM_CAP', '25'))


def plan_minutes(slot):
    return float((plan().get('minutes') or {}).get(slot) or 0)


def write_standard(uid):
    """the Standard as the company holds it today, for this person (sim/pilot3.py), into the run folder"""
    import cycle as CY, pilot3 as P3
    run, d = run_dir()
    os.makedirs(os.path.join(d, 'standard'), exist_ok=True)
    p = os.path.join(d, 'standard', f'{uid}.md')
    db = json.load(open(os.path.join(d, 'db.json'), encoding='utf-8')) if os.path.exists(os.path.join(d, 'db.json')) else {}
    open(p, 'w', encoding='utf-8').write(P3.standard_md(db, uid, CY.load_book()))
    return p


def prompt_p3(uid, b):
    """Pilot 3's turn prompt (sim/turn_prompt_p3.md): goals and measures from the top, a plan each morning, a review each
    evening, a why on every significant action, a budget of minutes, and the meeting's questions on the last day"""
    import cycle as CY
    run, d = run_dir(); P = plan(); B = CY.load_book()
    tpl = open(os.path.join(os.path.dirname(HERE), P['turn_prompt'])).read()
    st = admin('status'); t = st.get('turn') or {}
    cap = str(t['cap']) if t.get('uid') == uid else str(plan_cap(uid, b['slot']))
    mins = round((t.get('min_cap') if t.get('uid') == uid and t.get('min_cap') else plan_minutes(b['slot'])) or 0)
    day, last = b['day'], day_no() >= int(P.get('days') or 3)
    briefing = os.path.join(os.path.dirname(HERE), P.get('roles_dir', 'sim/roles'), uid + '.md')
    vals = {**{k: str(v) for k, v in b.items()}, 'weekday': date.fromisoformat(day).strftime('%A %B %-d'), 'slot_label': SLOT_LABEL.get(b['slot'], b['slot']),
            'cap': cap, 'minutes': str(mins or 'the rest of the'), 'root': os.path.dirname(HERE), 'briefing': briefing, 'diary': os.path.join(d, 'diary', uid + '.md'),
            'standard': write_standard(uid), 'objectives': '\n'.join('- ' + o for o in B['objectives'].get(uid, [])),
            'eod': 'yes' if b['slot'] == 'eod' else 'no'}
    T = my_tasks(uid, b['slot'])
    vals['tasks'] = ('Work that came in for you today:\n' + '\n'.join('- ' + x['task'] for x in T)) if T else ''
    vals['device'] = ('phone (390x844, touch, one hand)' if b['phone'] else 'desktop') + (
        '; this turn you may also pick up your ' + ('desktop' if b['phone'] else 'phone') + f' (`sim/act {uid} device ' + ('desktop' if b['phone'] else 'phone') + '`)' if b.get('switch') else '')
    if b['slot'] == 'morning':
        vals['plan_or_review'] = (f'Your first turn of the day: before anything else, write today\'s plan in your diary under `## {day} plan`: your priorities in order '
                                  'and why (your measures and the Standard\'s decision order), what could go wrong today, and what you will check before you call each thing done. Then work it.')
    elif b['slot'] == 'eod':
        vals['plan_or_review'] = 'The last turn of your day: finish what must not wait for tomorrow, then write your review (below).'
    else:
        vals['plan_or_review'] = 'Work your plan. If the day changed it (a call, a client, a problem on site), say in one diary line what moved and why.'
    eod = ''
    if b['slot'] == 'eod':
        eod = (f'Write `## {day} end of day` in your diary: what got done against this morning\'s plan; what you checked and how you checked it '
               '(for example: did the order show against its estimate line? does the invoice match the schedule of values? does AR tie to the bank?); '
               'what you hand off, to whom, by when; then the judgement blocks `_common.md` asks for, the UI/UX for the phone and the desktop each ending '
               'with its `Grade, phone: n/10` or `Grade, desktop: n/10` line.')
        if last:
            Q = B['questions'].get(uid, [])
            eod += ('\n  It is the day of the team meeting: bring your numbers. Find them in the app the way you would, then write them in your diary under '
                    '`## Numbers for the team meeting`, one line per question, `Q1: ...`, with the figures and where in the app you read them. If the app '
                    'cannot tell you, say so and say what you would do:\n' + '\n'.join(f'  - {q[0]}: {q[2]}' for q in Q))
    vals['eod_text'] = eod
    for k, v in vals.items(): tpl = tpl.replace('{' + k + '}', v)
    reads = 0
    for f in (os.path.join(HERE, 'roles', '_common.md'), briefing, vals['diary'], vals['standard'],
              os.path.join(d, 'files', uid, 'news.md'), os.path.join(d, 'files', uid, 'said.md')):
        try: reads += os.path.getsize(f)
        except Exception: pass
    try: admin('note_prompt', uid=uid, chars=len(tpl), reads=reads)
    except Exception: pass
    return tpl


ROLE_TITLE = {'u_owner': 'founder and owner of a design-build firm', 'u_alan': 'project manager', 'u_chen': 'procurement manager and coordinator', 'u_billing': 'construction billing and AR lead'}


def judge(uid, day=None):
    """the realism judge's prompt for one person's day (sim/realism_judge.md), with the trail written beside it"""
    import pilot3 as P3
    run, d = run_dir()
    st = admin('status'); day = day or st['day']
    A = [json.loads(l) for l in open(os.path.join(d, 'actions.jsonl')) if l.strip()]
    os.makedirs(os.path.join(d, 'judge'), exist_ok=True)
    tp = os.path.join(d, 'judge', f'{uid}_{day}_trail.md')
    open(tp, 'w', encoding='utf-8').write(P3.trail_md(A, uid, day))
    P = plan()
    vals = {'uid': uid, 'day': day, 'name': {'u_owner': 'Alan Mishali', 'u_alan': 'Alan (PM)', 'u_chen': 'Chen Biron', 'u_billing': 'Billing'}.get(uid, uid),
            'role_title': ROLE_TITLE.get(uid, 'professional'), 'briefing': os.path.join(os.path.dirname(HERE), P.get('roles_dir', 'sim/roles'), uid + '.md'),
            'standard': os.path.join(d, 'standard', f'{uid}.md'), 'diary': os.path.join(d, 'diary', uid + '.md'), 'trail': tp,
            'answer': os.path.join(d, 'judge', f'{uid}_{day}.json')}
    tpl = open(os.path.join(HERE, 'realism_judge.md')).read().split('-->', 1)[-1].strip()
    return P3.judge_prompt(tpl, vals)


def prompt_live(uid, b):
    """a live turn's prompt (sim/turn_prompt_live.md): the live site, two devices, no world, no clock pin"""
    run, d = run_dir()
    st = admin('status'); t = st.get('turn') or {}
    tpl = open(os.path.join(HERE, 'turn_prompt_live.md')).read()
    briefing = os.path.join(HERE, 'roles', 'p3', uid + '.md')
    if not os.path.exists(briefing): briefing = os.path.join(HERE, 'roles', uid + '.md')
    from datetime import datetime as _dt
    vals = {'name': b['name'], 'role': b['role'], 'uid': uid, 'run': run, 'site': b['site'], 'live': b['live'], 'clock': b['clock'],
            'weekday': _dt.fromisoformat(b['day']).strftime('%A %B %-d'), 'root': os.path.dirname(HERE), 'briefing': briefing,
            'diary': os.path.join(d, 'diary', uid + '.md'), 'cap': str(t.get('cap') or 15),
            'device': 'phone (390x844, touch, one hand)' if b['phone'] else 'desktop'}
    for k, v in vals.items(): tpl = tpl.replace('{' + k + '}', v)
    reads = sum(os.path.getsize(f) for f in (os.path.join(HERE, 'roles', '_common.md'), briefing, os.path.join(os.path.dirname(HERE), '.claude', 'agents', '_LOOP.md')) if os.path.exists(f))
    try: admin('note_prompt', uid=uid, chars=len(tpl), reads=reads)
    except Exception: pass
    return tpl


def prompt(uid):
    b = admin('brief', uid=uid)
    if b.get('live'): return prompt_live(uid, b)
    if plan().get('turn_prompt'): return prompt_p3(uid, b)
    run, d = run_dir()
    tpl = open(os.path.join(HERE, 'turn_prompt.md')).read()
    cap = str(plan().get('caps', {}).get(b['slot']) or os.environ.get('SIM_CAP', '25'))
    vals = {**{k: str(v) for k, v in b.items()}, 'weekday': date.fromisoformat(b['day']).strftime('%A %B %-d'), 'slot_label': SLOT_LABEL.get(b['slot'], b['slot']),
            'cap': cap, 'root': os.path.dirname(HERE), 'briefing': os.path.join(HERE, 'roles', uid + '.md'), 'diary': os.path.join(d, 'diary', uid + '.md'),
            'device': 'phone' if b['phone'] else 'desktop', 'eod': 'yes' if b['slot'] == 'eod' else 'no'}
    T = my_tasks(uid, b['slot'])
    st = admin('status')
    if (st.get('turn') or {}).get('uid') == uid: vals['cap'] = str(st['turn']['cap'])
    vals['tasks'] = ('Work that came in for you today (do it as part of your turn, on your ' + vals['device'] + '):\n'
                     + '\n'.join('- ' + t['task'] for t in T)) if T else 'No special work came in for this turn; run your day.'
    if T: vals['cap'] = str(max(int(vals['cap']), max(t.get('cap', 0) for t in T)))
    vals['device'] = ('phone (390x844, touch, one hand)' if b['phone'] else 'desktop') + (
        '; this turn you may also pick up your ' + ('desktop' if b['phone'] else 'phone') + f' (`sim/act {uid} device ' + ('desktop' if b['phone'] else 'phone') + '`)' if b.get('switch') else '')
    vals['last_day'] = 'yes' if day_no() >= int(plan().get('days') or 3) else 'no'
    for k, v in vals.items(): tpl = tpl.replace('{' + k + '}', v)
    reads = 0
    for f in (os.path.join(HERE, 'roles', '_common.md'), vals['briefing'], vals['diary']):
        try: reads += os.path.getsize(f)
        except Exception: pass
    try: admin('note_prompt', uid=uid, chars=len(tpl), reads=reads)
    except Exception: pass
    return tpl


def main(a):
    if not a or a[0] in ('-h', '--help'): print(__doc__.strip()); return 2
    c = a[0]
    if c == 'prompt': print(prompt(a[1])); return 0
    if c == 'status': r = admin('status')
    elif c == 'world':
        kw = {'slot': a[1]}
        if '--no-watchers' in a: kw['watchers'] = False
        if '--watchers' in a: kw['watchers'] = True
        r = admin('world', **kw)
    elif c == 'begin' and admin('status').get('live'):   # a live run (sim/live.py): one person, both devices, no plan
        dev = a[a.index('--device') + 1].lower() if '--device' in a else ''
        r = admin('begin_turn', uid=a[1], cap=int(a[a.index('--cap') + 1]) if '--cap' in a else 15, device=dev)
    elif c == 'begin':
        slot =a[2] if len(a) > 2 and not a[2].startswith('--') else admin('status')['slot']
        cap = int(a[a.index('--cap') + 1]) if '--cap' in a else plan_cap(a[1], slot)
        minutes = float(a[a.index('--minutes') + 1]) if '--minutes' in a else plan_minutes(slot)
        admin('slot', slot=slot)
        T = my_tasks(a[1], slot)
        if T: cap = max(cap, max(t.get('cap', 0) for t in T))
        dev = a[a.index('--device') + 1].lower() if '--device' in a else 'phone' if '--phone' in a else plan_device(a[1], slot, T)
        if '+' in dev: dev, switch = dev.split('+')[0], True
        else: switch = '--switch' in a
        if switch and not ('--cap' in a): cap += int(plan().get('switch_cap') or 0)   # looking at the other device costs a few actions
        r = admin('begin_turn', uid=a[1], slot=slot, cap=cap, minutes=minutes, device=dev, switch=switch, phone=dev == 'phone')
        if T: r['tasks'] = [t['doc'] + f" on the {task_device(t) or r['turn']['device']}" for t in T]
    elif c == 'plan':
        run, d = run_dir(); open(os.path.join(d, 'plan.txt'), 'w').write(a[1]); r = {'plan': a[1]}
    elif c == 'end': r = admin('end_turn')
    elif c == 'brief': r = admin('brief', uid=a[1])
    elif c == 'referee': r = admin('referee', final='--final' in a)
    elif c == 'advance': r = admin('advance')
    elif c == 'persist': r = admin('persist_check')
    elif c == 'check': r = admin('check', checks=json.loads(a[1]))
    elif c == 'debug-eval': r = admin('debug_eval', uid=a[1], js=a[2])
    elif c == 'menus': r = admin('menu_capture')
    elif c == 'client-docs': r = admin('client_docs')
    elif c == 'party': r = admin('party', party=a[1], patch=json.loads(a[2]))
    elif c == 'world-client': r = admin('world_client', on=a[1] == 'on')
    elif c == 'world-agent': r = admin('world_agent', on=a[1] == 'on')
    elif c == 'world-voice': r = admin('world_voice', on=a[1] == 'on')
    elif c == 'cycle': r = admin('cycle', on=a[1] == 'on', play=a[a.index('--play') + 1].split(',') if '--play' in a else [])
    elif c == 'script': r = admin('script', payload=json.loads(a[1]))
    elif c == 'judge':
        print(judge(a[1], a[a.index('--day') + 1] if '--day' in a else None)); return 0
    elif c == 'cost':
        kw = {'uid': a[1]} if a[1].startswith('u_') else {'label': a[1]}
        for k in ('tokens', 'tool-uses', 'ms', 'input', 'output', 'cache-read'):
            if '--' + k in a: kw[k.replace('-', '_')] = int(float(a[a.index('--' + k) + 1]))
        r = admin('cost', **kw)
    elif c == 'stop': r = admin('shutdown')
    else: print('unknown command; see --help'); return 2
    if c == 'world' and isinstance(r, dict) and 'events' in r:
        ev = [e for e in r['events'] if e[1] not in ('seed', 'due')]
        print(f"{r['day']} {r['slot']}: {len(r['events'])} events ({len(ev)} delivered)")
        for e in ev: print('  ', ' · '.join(map(str, e)))
        for x in r.get('replies') or []: print('   reply', ' · '.join(map(str, x)))
        if r.get('gates'): print('   chains opened:', ', '.join(f'{g[0]} (on {g[1]})' for g in r['gates']))
        if r.get('mail'): print('   mail:', r['mail'])
        if r.get('watchers'): print('   watchers:', '; '.join(f'{k[2:]} {v}' for k, v in r['watchers'].items()))
        return 0
    print(json.dumps(r, indent=1, default=str)[:20000])
    return 1 if isinstance(r, dict) and r.get('error') else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
