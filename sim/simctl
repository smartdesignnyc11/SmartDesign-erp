#!/usr/bin/env python3
"""sim/simctl: the main session's controls for the agent month (never given to the role agents).

    sim/simctl status
    sim/simctl world <morning|work1|work2|eod> [--no-watchers|--watchers]   the outside world's events for the slot
    sim/simctl begin <uid> <slot> [--cap N]     open a person's turn (only they may act until `end`)
    sim/simctl end                              close the turn: save, deliver the mail they sent
    sim/simctl prompt <uid>                     print the filled per-turn prompt (sim/turn_prompt.md) for that person
    sim/simctl brief <uid>                      their news and unread mail counts (to decide optional turns)
    sim/simctl referee [--final]                score the world now (writes ledger.json and ledger.md)
    sim/simctl advance                          score the day, keep a copy of the snapshot, move to the next working day
    sim/simctl persist                          the PERSIST reload check (end of the run)
    sim/simctl check '<json list of month_runtime checks>'
    sim/simctl party "<name>" '<json patch>'      change an outside party's rules, e.g. '{"reply_p": 1, "delay": [0, 0]}'
    sim/simctl world-agent on|off               write each scheduled outside reply to world/pending/ for an LLM to voice
    sim/simctl menus                            capture each person's menu and tabs to runs/<run>/menus.json (menu workshop)
    sim/simctl stop                             save everything and stop the server
"""
import json, os, sys, urllib.request
from datetime import date

HERE = os.path.dirname(os.path.abspath(__file__))
SLOT_LABEL = {'morning': 'morning (brief, huddle, plan)', 'work1': 'the work day, first turn', 'work2': 'the work day, second turn',
              'eod': 'end of day (log, confirm tomorrow, diary, judgement)'}


def run_dir():
    run = os.environ.get('SIM_RUN') or open(os.path.join(HERE, 'runs', '.current')).read().strip()
    return run, os.path.join(HERE, 'runs', run)


def admin(cmd, **kw):
    run, d = run_dir()
    port = json.load(open(os.path.join(d, 'server.json')))['port']
    tok = open(os.path.join(d, '.admin_token')).read().strip()
    req = urllib.request.Request(f'http://127.0.0.1:{port}/admin', data=json.dumps({'cmd': cmd, **kw}).encode(),
                                 headers={'Content-Type': 'application/json', 'X-Sim-Token': tok})
    with urllib.request.urlopen(req, timeout=1800) as f: return json.loads(f.read())


def prompt(uid):
    b = admin('brief', uid=uid)
    run, d = run_dir()
    tpl = open(os.path.join(HERE, 'turn_prompt.md')).read()
    cap = os.environ.get('SIM_CAP', '25')
    vals = {**{k: str(v) for k, v in b.items()}, 'weekday': date.fromisoformat(b['day']).strftime('%A %B %-d'), 'slot_label': SLOT_LABEL.get(b['slot'], b['slot']),
            'cap': cap, 'root': os.path.dirname(HERE), 'briefing': os.path.join(HERE, 'roles', uid + '.md'), 'diary': os.path.join(d, 'diary', uid + '.md'),
            'device': 'phone' if b['phone'] else 'desktop', 'eod': 'yes' if b['slot'] == 'eod' else 'no'}
    for k, v in vals.items(): tpl = tpl.replace('{' + k + '}', v)
    return tpl


def main(a):
    if not a or a[0] in ('-h', '--help'): print(__doc__.strip()); return 2
    c = a[0]
    if c == 'prompt': print(prompt(a[1])); return 0
    if c == 'status': r = admin('status')
    elif c == 'world':
        kw = {'slot': a[1]}
        if '--no-watchers' in a: kw['watchers'] = False
        if '--watchers' in a: kw['watchers'] = True
        r = admin('world', **kw)
    elif c == 'begin':
        cap = int(a[a.index('--cap') + 1]) if '--cap' in a else int(os.environ.get('SIM_CAP', '25'))
        r = admin('begin_turn', uid=a[1], slot=a[2] if len(a) > 2 and not a[2].startswith('--') else None, cap=cap)
    elif c == 'end': r = admin('end_turn')
    elif c == 'brief': r = admin('brief', uid=a[1])
    elif c == 'referee': r = admin('referee', final='--final' in a)
    elif c == 'advance': r = admin('advance')
    elif c == 'persist': r = admin('persist_check')
    elif c == 'check': r = admin('check', checks=json.loads(a[1]))
    elif c == 'debug-eval': r = admin('debug_eval', uid=a[1], js=a[2])
    elif c == 'menus': r = admin('menu_capture')
    elif c == 'party': r = admin('party', party=a[1], patch=json.loads(a[2]))
    elif c == 'world-agent': r = admin('world_agent', on=a[1] == 'on')
    elif c == 'stop': r = admin('shutdown')
    else: print('unknown command; see --help'); return 2
    if c == 'world' and isinstance(r, dict) and 'events' in r:
        ev = [e for e in r['events'] if e[1] not in ('seed', 'due')]
        print(f"{r['day']} {r['slot']}: {len(r['events'])} events ({len(ev)} delivered)")
        for e in ev: print('  ', ' · '.join(map(str, e)))
        for x in r.get('replies') or []: print('   reply', ' · '.join(map(str, x)))
        if r.get('mail'): print('   mail:', r['mail'])
        if r.get('watchers'): print('   watchers:', '; '.join(f'{k[2:]} {v}' for k, v in r['watchers'].items()))
        return 0
    print(json.dumps(r, indent=1, default=str)[:20000])
    return 1 if isinstance(r, dict) and r.get('error') else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
