#!/usr/bin/env python3
"""sim/simctl: the main session's controls for the agent month (never given to the role agents).

    sim/simctl status
    sim/simctl world <morning|work1|work2|eod> [--no-watchers|--watchers]   the outside world's events for the slot
    sim/simctl plan sim/day_plan_lean.json       which day plan this run follows (default sim/day_plan.json)
    sim/simctl begin <uid> <slot> [--cap N] [--device phone|desktop] [--switch]   open a person's turn (only they may
                                                act until `end`); the plan's cap for the slot, raised by a doc task; the device
                                                from the doc task, else the plan's `devices` (day, slot, person), else the role's;
                                                --switch (or "phone+desktop" in the plan) lets them pick up the other device
    sim/simctl cost <uid|label> --tokens N [--tool-uses N] [--ms N]   the subagent's measured usage for the turn just
                                                ended (copy it from the Agent tool's result); written to cost.jsonl and cost.md
    sim/simctl end                              close the turn: save, deliver the mail they sent
    sim/simctl prompt <uid>                     print the filled per-turn prompt (sim/turn_prompt.md) for that person
    sim/simctl brief <uid>                      their news and unread mail counts (to decide optional turns)
    sim/simctl referee [--final]                score the world now (writes ledger.json and ledger.md)
    sim/simctl advance                          score the day, keep a copy of the snapshot, move to the next working day
    sim/simctl persist                          the PERSIST reload check (end of the run)
    sim/simctl check '<json list of month_runtime checks>'
    sim/simctl party "<name>" '<json patch>'      change an outside party's rules, e.g. '{"reply_p": 1, "delay": [0, 0]}'
    sim/simctl world-client on|off              the client's portal side (approve, ask, pay) played by world rules (lean plan)
    sim/simctl world-agent on|off               write each scheduled outside reply to world/pending/ for an LLM to voice
    sim/simctl menus                            capture each person's menu and tabs to runs/<run>/menus.json (menu workshop)
    sim/simctl client-docs                      render every client-facing document created (print, PDF, portal) to runs/<run>/client_docs/
    sim/simctl stop                             save everything and stop the server
"""
import json, os, sys, urllib.request
from datetime import date

HERE = os.path.dirname(os.path.abspath(__file__))
def plan():
    run, d = run_dir()
    f = os.environ.get('SIM_PLAN') or (open(os.path.join(d, 'plan.txt')).read().strip() if os.path.exists(os.path.join(d, 'plan.txt')) else os.path.join(HERE, 'day_plan.json'))
    return json.load(open(f if os.path.isabs(f) else os.path.join(os.path.dirname(HERE), f)))


def day_no():
    return len(admin('status').get('days_done') or []) + 1


def my_tasks(uid, slot):
    """the Documents Workshop's work that came in for this person, this day and slot (day_plan doc_tasks)"""
    day = day_no()
    return [t for t in plan().get('doc_tasks', []) if t['uid'] == uid and t['day'] == day and t['slot'] == slot]


def task_device(t):
    return (t.get('device') or ('phone' if t.get('phone') else '')).lower()


def plan_device(uid, slot, tasks):
    """The device for this turn: a task's device first, then the plan's `devices` for the day and slot, then the plan's
    default for the person; "phone+desktop" starts on the phone and lets the person switch (`act <uid> device desktop`)."""
    P = plan().get('devices') or {}
    for t in tasks:
        if task_device(t): return task_device(t)
    d = ((P.get(str(day_no())) or {}).get(slot) or {}).get(uid) or (P.get('default') or {}).get(uid) or ''
    return d.lower()


SLOT_LABEL = {'work': 'the work day', 'morning': 'morning (brief, huddle, plan)', 'work1': 'the work day, first turn', 'work2': 'the work day, second turn',
              'eod': 'end of day (log, confirm tomorrow, diary, judgement)'}


def run_dir():
    run = os.environ.get('SIM_RUN') or open(os.path.join(HERE, 'runs', '.current')).read().strip()
    return run, os.path.join(HERE, 'runs', run)


def admin(cmd, **kw):
    run, d = run_dir()
    port = json.load(open(os.path.join(d, 'server.json')))['port']
    tok = open(os.path.join(d, '.admin_token')).read().strip()
    req = urllib.request.Request(f'http://127.0.0.1:{port}/admin', data=json.dumps({'cmd': cmd, **kw}).encode(),
                                 headers={'Content-Type': 'application/json', 'X-Sim-Token': tok})
    with urllib.request.urlopen(req, timeout=1800) as f: return json.loads(f.read())


def prompt(uid):
    b = admin('brief', uid=uid)
    run, d = run_dir()
    tpl = open(os.path.join(HERE, 'turn_prompt.md')).read()
    cap = str(plan().get('caps', {}).get(b['slot']) or os.environ.get('SIM_CAP', '25'))
    vals = {**{k: str(v) for k, v in b.items()}, 'weekday': date.fromisoformat(b['day']).strftime('%A %B %-d'), 'slot_label': SLOT_LABEL.get(b['slot'], b['slot']),
            'cap': cap, 'root': os.path.dirname(HERE), 'briefing': os.path.join(HERE, 'roles', uid + '.md'), 'diary': os.path.join(d, 'diary', uid + '.md'),
            'device': 'phone' if b['phone'] else 'desktop', 'eod': 'yes' if b['slot'] == 'eod' else 'no'}
    T = my_tasks(uid, b['slot'])
    st = admin('status')
    if (st.get('turn') or {}).get('uid') == uid: vals['cap'] = str(st['turn']['cap'])
    vals['tasks'] = ('Work that came in for you today (do it as part of your turn, on your ' + vals['device'] + '):\n'
                     + '\n'.join('- ' + t['task'] for t in T)) if T else 'No special work came in for this turn; run your day.'
    if T: vals['cap'] = str(max(int(vals['cap']), max(t.get('cap', 0) for t in T)))
    vals['device'] = ('phone (390x844, touch, one hand)' if b['phone'] else 'desktop') + (
        '; this turn you may also pick up your ' + ('desktop' if b['phone'] else 'phone') + f' (`sim/act {uid} device ' + ('desktop' if b['phone'] else 'phone') + '`)' if b.get('switch') else '')
    vals['last_day'] = 'yes' if day_no() >= int(plan().get('days') or 3) else 'no'
    for k, v in vals.items(): tpl = tpl.replace('{' + k + '}', v)
    reads = 0
    for f in (os.path.join(HERE, 'roles', '_common.md'), vals['briefing'], vals['diary']):
        try: reads += os.path.getsize(f)
        except Exception: pass
    try: admin('note_prompt', uid=uid, chars=len(tpl), reads=reads)
    except Exception: pass
    return tpl


def main(a):
    if not a or a[0] in ('-h', '--help'): print(__doc__.strip()); return 2
    c = a[0]
    if c == 'prompt': print(prompt(a[1])); return 0
    if c == 'status': r = admin('status')
    elif c == 'world':
        kw = {'slot': a[1]}
        if '--no-watchers' in a: kw['watchers'] = False
        if '--watchers' in a: kw['watchers'] = True
        r = admin('world', **kw)
    elif c == 'begin':
        slot = a[2] if len(a) > 2 and not a[2].startswith('--') else admin('status')['slot']
        cap = int(a[a.index('--cap') + 1]) if '--cap' in a else int(plan().get('caps', {}).get(slot) or os.environ.get('SIM_CAP', '25'))
        admin('slot', slot=slot)
        T = my_tasks(a[1], slot)
        if T: cap = max(cap, max(t.get('cap', 0) for t in T))
        dev = a[a.index('--device') + 1].lower() if '--device' in a else 'phone' if '--phone' in a else plan_device(a[1], slot, T)
        if '+' in dev: dev, switch = dev.split('+')[0], True
        else: switch = '--switch' in a
        if switch and not ('--cap' in a): cap += int(plan().get('switch_cap') or 0)   # looking at the other device costs a few actions
        r = admin('begin_turn', uid=a[1], slot=slot, cap=cap, device=dev, switch=switch, phone=dev == 'phone')
        if T: r['tasks'] = [t['doc'] + f" on the {task_device(t) or r['turn']['device']}" for t in T]
    elif c == 'plan':
        run, d = run_dir(); open(os.path.join(d, 'plan.txt'), 'w').write(a[1]); r = {'plan': a[1]}
    elif c == 'end': r = admin('end_turn')
    elif c == 'brief': r = admin('brief', uid=a[1])
    elif c == 'referee': r = admin('referee', final='--final' in a)
    elif c == 'advance': r = admin('advance')
    elif c == 'persist': r = admin('persist_check')
    elif c == 'check': r = admin('check', checks=json.loads(a[1]))
    elif c == 'debug-eval': r = admin('debug_eval', uid=a[1], js=a[2])
    elif c == 'menus': r = admin('menu_capture')
    elif c == 'client-docs': r = admin('client_docs')
    elif c == 'party': r = admin('party', party=a[1], patch=json.loads(a[2]))
    elif c == 'world-client': r = admin('world_client', on=a[1] == 'on')
    elif c == 'world-agent': r = admin('world_agent', on=a[1] == 'on')
    elif c == 'cost':
        kw = {'uid': a[1]} if a[1].startswith('u_') else {'label': a[1]}
        for k in ('tokens', 'tool-uses', 'ms', 'input', 'output', 'cache-read'):
            if '--' + k in a: kw[k.replace('-', '_')] = int(float(a[a.index('--' + k) + 1]))
        r = admin('cost', **kw)
    elif c == 'stop': r = admin('shutdown')
    else: print('unknown command; see --help'); return 2
    if c == 'world' and isinstance(r, dict) and 'events' in r:
        ev = [e for e in r['events'] if e[1] not in ('seed', 'due')]
        print(f"{r['day']} {r['slot']}: {len(r['events'])} events ({len(ev)} delivered)")
        for e in ev: print('  ', ' · '.join(map(str, e)))
        for x in r.get('replies') or []: print('   reply', ' · '.join(map(str, x)))
        if r.get('gates'): print('   chains opened:', ', '.join(f'{g[0]} (on {g[1]})' for g in r['gates']))
        if r.get('mail'): print('   mail:', r['mail'])
        if r.get('watchers'): print('   watchers:', '; '.join(f'{k[2:]} {v}' for k, v in r['watchers'].items()))
        return 0
    print(json.dumps(r, indent=1, default=str)[:20000])
    return 1 if isinstance(r, dict) and r.get('error') else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
